@startuml
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
title BLL: моделі, mapping і винятки
package "Models" {
  class UserModel
  class RegisterInputModel
  class LoginInputModel
  class CountryModel
  class RegionModel
  class TourModel {
    FinalPrice, IsHot, FreePlaces, Nights
  }
  class TourInputModel
  class TourSearchModel
  class TourBookingModel
  class RoomBookingModel
  class TicketBookingModel
  class TourBookingInputModel
  class RoomBookingInputModel
  class TicketBookingInputModel
  class HotelModel
  class RoomModel {
    Capacity, Quantity
  }
  class TripModel {
    Capacity, FreePlaces
  }
  enum UserRole
  enum TourType
  enum BookingStatus
  enum TransportType
  enum TourSortOrder
}
note bottom of Models
  Переліки називаються так само, як у DAL
  (інший простір імен); значення збігаються.
end note
package Mapping <<internal>> {
  class EntityMapper <<static>> {
    + ToModel(entity)
    + ApplyTo(input, entity)
  }
  class EnumMapper <<static>> {
    + ToModel(enum) / ToEntity(enum)
  }
}
package Exceptions {
  abstract class BusinessException
  class EntityNotFoundException <<404>>
  class ValidationFailedException <<400>>
  class ConflictException <<409>>
  class AccessDeniedException <<403>>
  class InvalidCredentialsException <<401>>
}
BusinessException <|-- EntityNotFoundException
BusinessException <|-- ValidationFailedException
BusinessException <|-- ConflictException
BusinessException <|-- AccessDeniedException
BusinessException <|-- InvalidCredentialsException
EntityMapper ..> Models
EntityMapper ..> EnumMapper
@enduml
