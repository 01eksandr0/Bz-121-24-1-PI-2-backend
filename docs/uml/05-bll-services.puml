@startuml
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
title BLL: сервіси, інтерфейси і допоміжні класи
package Interfaces {
  interface IAuthService
  interface IUserService
  interface ICountryService
  interface ITourService {
    + Search(filter)
    + GetById(id)
    + Create(input)
    + Update(id, input)
    + Delete(id)
  }
  interface ITourBookingService {
    + Book(userId, model)
    + GetByUser(userId)
    + GetAll()
    + Cancel(bookingId, userId)
  }
  interface IHotelService
  interface IRoomBookingService
  interface ITripService
  interface ITicketBookingService
}
package Services <<internal>> {
  class AuthService
  class UserService
  class CountryService
  class TourService
  abstract class "BookingServiceBase<TBooking, TModel>" as BSB {
    + GetByUser(userId)
    + GetAll()
    + Cancel(bookingId, userId)
    # Add(booking) / Reload(booking)
    # {abstract} StartOf(booking)
    # {abstract} ToModel(booking)
    # {abstract} CancellationDeadlineDays
  }
  class TourBookingService
  class HotelService
  class RoomBookingService
  class TripService
  class TicketBookingService
}
package Internal <<internal>> {
  class BookingCancellationPolicy <<static>>
  class Occupancy <<static>> {
    + TourPlaces(ids)
    + TripPlaces(ids)
    + Rooms(ids, checkIn, checkOut)
  }
  class UnitOfWorkExtensions <<static>> {
    + InTransaction(action)
  }
  class Guard <<static>>
  class UserGuard <<static>>
  class StayPeriod <<static>>
  class RepositoryExtensions <<static>>
  class EmailRules <<static>>
}
package Common <<internal>> {
  interface IClock
  class SystemClock
  class Pricing <<static>>
  class BusinessRules <<static>>
}
package Security <<internal>> {
  interface IPasswordHasher
  class Pbkdf2PasswordHasher
}
interface IUnitOfWork <<DAL.Abstractions>>
IAuthService <|.. AuthService
IUserService <|.. UserService
ICountryService <|.. CountryService
ITourService <|.. TourService
ITourBookingService <|.. TourBookingService
IHotelService <|.. HotelService
IRoomBookingService <|.. RoomBookingService
ITripService <|.. TripService
ITicketBookingService <|.. TicketBookingService
BSB <|-- TourBookingService
BSB <|-- RoomBookingService
BSB <|-- TicketBookingService
IClock <|.. SystemClock
IPasswordHasher <|.. Pbkdf2PasswordHasher
Services ..> IUnitOfWork
BSB ..> IClock
AuthService ..> IPasswordHasher
BSB ..> BookingCancellationPolicy
BSB ..> UnitOfWorkExtensions
TourBookingService ..> Pricing
TourService ..> Occupancy
TripService ..> Occupancy
HotelService ..> Occupancy
BSB ..> Occupancy
RoomBookingService ..> StayPeriod
HotelService ..> StayPeriod
Services ..> Guard
Services ..> RepositoryExtensions
@enduml
