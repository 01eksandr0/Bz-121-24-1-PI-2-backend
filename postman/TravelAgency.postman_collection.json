{
  "info": {
    "name": "TravelAgency WebAPI",
    "description": "Курсова робота, варіант 2. Перед першим запуском база має бути щойно створеною (демо-дані). Run collection виконує всі запити по черзі.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// дати рахуються від сьогодні, щоб колекція працювала в будь-який день",
          "const day = n => { const d = new Date(); d.setDate(d.getDate() + n); return d.toISOString().slice(0, 10); };",
          "pm.collectionVariables.set('futureStart', day(40));",
          "pm.collectionVariables.set('futureEnd', day(47));",
          "pm.collectionVariables.set('checkIn', day(20));",
          "pm.collectionVariables.set('checkOut', day(23));"
        ]
      }
    }
  ],
  "item": [
